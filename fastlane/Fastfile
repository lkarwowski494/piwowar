# Fastlane configuration for Piwowar (Brewcraft)
default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    api_key = nil
    if ENV["ASC_KEY_ID"] && ENV["ASC_ISSUER_ID"] && ENV["ASC_KEY_CONTENT"]
      is_base64 = !ENV["ASC_KEY_CONTENT"].include?("BEGIN")
      api_key = app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_content: ENV["ASC_KEY_CONTENT"],
        is_key_content_base64: is_base64,
        in_house: false
      )
      # Automatyczne pobranie lub wygenerowanie certyfikatu i profilu z Apple Developer
      get_certificates(api_key: api_key)
      get_provisioning_profile(api_key: api_key)
    end

    workspace_path = File.expand_path("../ios/PiwowarBrewcraft.xcworkspace", __dir__)
    project_path = File.expand_path("../ios/PiwowarBrewcraft.xcodeproj", __dir__)

    # Auto-detect real Apple Team ID from downloaded Provisioning Profile
    team_id = ENV["APPLE_TEAM_ID"]
    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH] || Dir["*.mobileprovision"].first
    if profile_path && File.exist?(profile_path)
      parsed = `security cms -D -i "#{profile_path}" 2>/dev/null`
      if parsed =~ /<key>TeamIdentifier<\/key>\s*<array>\s*<string>([^<]+)<\/string>/m
        team_id = $1
        UI.success("Auto-detected Apple Team ID from Provisioning Profile: #{team_id}")
      end
    end

    if team_id && !team_id.empty?
      update_project_team(
        path: project_path,
        teamid: team_id
      )
    end

    build_app(
      workspace: workspace_path,
      scheme: "PiwowarBrewcraft",
      export_method: "app-store",
      export_options: team_id ? { teamID: team_id } : {}
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Deploy a new version to the App Store"
  lane :release do
    api_key = nil
    if ENV["ASC_KEY_ID"] && ENV["ASC_ISSUER_ID"] && ENV["ASC_KEY_CONTENT"]
      is_base64 = !ENV["ASC_KEY_CONTENT"].include?("BEGIN")
      api_key = app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_content: ENV["ASC_KEY_CONTENT"],
        is_key_content_base64: is_base64,
        in_house: false
      )
      get_certificates(api_key: api_key)
      get_provisioning_profile(api_key: api_key)
    end

    workspace_path = File.expand_path("../ios/PiwowarBrewcraft.xcworkspace", __dir__)
    project_path = File.expand_path("../ios/PiwowarBrewcraft.xcodeproj", __dir__)

    team_id = ENV["APPLE_TEAM_ID"]
    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH] || Dir["*.mobileprovision"].first
    if profile_path && File.exist?(profile_path)
      parsed = `security cms -D -i "#{profile_path}" 2>/dev/null`
      if parsed =~ /<key>TeamIdentifier<\/key>\s*<array>\s*<string>([^<]+)<\/string>/m
        team_id = $1
      end
    end

    if team_id && !team_id.empty?
      update_project_team(
        path: project_path,
        teamid: team_id
      )
    end

    build_app(
      workspace: workspace_path,
      scheme: "PiwowarBrewcraft",
      export_method: "app-store",
      export_options: team_id ? { teamID: team_id } : {}
    )

    upload_to_app_store(
      api_key: api_key,
      force: true,
      skip_metadata: false,
      skip_screenshots: false
    )
  end
end
