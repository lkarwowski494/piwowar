{
  "name": "piwowar",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "description": "Piwowar (Brewcraft) — Apps4Brew: asystent domowego i rzemieślniczego warzenia piwa, kalkulatory zacierania i chmielenia, refraktometria, monitoring fermentacji i rejestr warek offline",
  "scripts": {
    "start": "expo start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "verify": "npm run check:i18n && npm run typecheck && npm test",
    "build:ios": "eas build --platform ios --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "ship:testflight": "eas build --platform ios --profile production --auto-submit"
  },
  "dependencies": {
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-sharing": "~57.0.22",
    "expo-sqlite": "~57.0.3",
    "fast-xml-parser": "^5.0.8",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~57.0.0",
    "fast-check": "^4.10.2",
    "jest": "^29.7.0",
    "typescript": "^5.5.4"
  }
}
